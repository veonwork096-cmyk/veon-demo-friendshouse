---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Location from "../components/Location.astro";
import Homes from "../components/Homes.astro";
import Plots from "../components/Plots.astro";
import Infrastructure from "../components/Infrastructure.astro";
import Safety from "../components/Safety.astro";
import Community from "../components/Community.astro";
import Visit from "../components/Visit.astro";
import Footer from "../components/Footer.astro";
import MobileBar from "../components/MobileBar.astro";
import { contacts, socials } from "../data/site";

const title = "Міжріччя — котеджне містечко біля Києва між Десною і Дніпром";
const description = "Будинки і ділянки в КМ Міжріччя, с. Осещина: парк 4 га на Десні, 8 озер, школа, закрита територія. Запис на перегляд щодня 08:00–20:00.";
const ld = {
  "@context": "https://schema.org",
  "@type": "RealEstateAgent",
  name: "Котеджне містечко Міжріччя",
  alternateName: "Міжріччя Friends Town",
  telephone: ["+380985075757", "+380954556671"],
  address: { "@type": "PostalAddress", streetAddress: "КМ Міжріччя", addressLocality: "Осещина", addressRegion: "Київська область", addressCountry: "UA" },
  openingHoursSpecification: { "@type": "OpeningHoursSpecification", dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"], opens: "08:00", closes: "20:00" },
  sameAs: socials.map((s) => s.href),
  hasMap: contacts.maps,
};
---
<Base lang="uk" title={title} description={description}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(ld)} />
  <Header slot="header" />
  <Hero />
  <Location />
  <Homes />
  <Plots />
  <Infrastructure />
  <Safety />
  <Community />
  <Visit />
  <Footer slot="footer" />
  <MobileBar slot="footer" />
</Base>
