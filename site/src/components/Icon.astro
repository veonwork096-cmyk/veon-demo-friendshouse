---
// Small line icons (stroke = currentColor). Decorative: hidden from assistive tech.
interface Props { name: "phone" | "menu" | "close" | "play" | "telegram" | "route" | "chat"; class?: string; }
const { name, class: cls } = Astro.props;
---
<svg class={cls} viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === "phone" && <path d="M6.6 3.5h2.6l1.4 4-2 1.3a12 12 0 0 0 6.6 6.6l1.3-2 4 1.4v2.6a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 4.6 5.7a2 2 0 0 1 2-2.2Z" />}
  {name === "menu" && <path d="M4 7h16M4 12h16M4 17h16" />}
  {name === "close" && <path d="M6 6l12 12M18 6 6 18" />}
  {name === "play" && <path d="M8 5.5v13l10.5-6.5L8 5.5Z" fill="currentColor" />}
  {name === "telegram" && <path d="m21 4-18 7.2 5.6 2 2 6.3 3.2-3.8 4.7 3.5L21 4Zm-12.4 9.2 9.6-6.4" />}
  {name === "chat" && <path d="M4 19.5 5.3 15A8 8 0 1 1 9 18.7L4 19.5Z" />}
  {name === "route" && <path d="M6 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4Zm12-10a2 2 0 1 0 0-4 2 2 0 0 0 0 4ZM8 17h7.5a3 3 0 0 0 0-6h-7a3 3 0 0 1 0-6H16" />}
</svg>
