---
import Section from "./Section.astro";
import Icon from "./Icon.astro";
import { contacts, nearby } from "../data/site";
// Scheme traced from the client's own map (wp-content/uploads/2025/10/sajt_karta-scaled.jpg): Kyiv reservoir and Dnipro,
// the Desna joining it from the east, Vyshhorod on the right bank, Osesсhina and the P69 road. Not to scale.
---
<Section id="location" class="location section">
  <div class="container grid location__grid">
    <div class="location__intro">
      <h2>Де ми: між двома ріками</h2>
      <p class="lead">Містечко стоїть у селі Осещина Вишгородського району, на березі Десни, між Десною і Дніпром. До центру Києва 23&nbsp;км.</p>
    </div>

    <figure class="location__map" data-draw>
      <svg viewBox="160 0 900 520" role="img" aria-label="Схема розташування Міжріччя між Десною і Дніпром" class="scheme">
        <g class="scheme__land">
          <path class="scheme__road" d="M300 318 C318 300 332 262 352 246 L470 229 L590 226 C622 204 652 172 690 142 L800 70 L860 0" />
          <text class="scheme__road-label" x="742" y="86">P69</text>
        </g>
        <g class="scheme__rivers">
          <path class="scheme__lake" d="M383 0 L572 0 C570 70 562 150 546 214 L472 230 C440 168 402 90 383 0 Z" />
          <path class="scheme__river scheme__river--dnipro" d="M509 228 C503 290 494 340 498 392 C503 440 528 476 556 512 L568 520" />
          <path class="scheme__river scheme__river--desna" d="M1060 140 C1010 150 980 200 950 240 C910 290 860 320 800 335 C750 348 715 360 690 385 C660 415 610 435 520 452" />
        </g>
        <g class="scheme__names">
          <text class="scheme__hydro" x="480" y="356" text-anchor="end">Дніпро</text>
          <text class="scheme__hydro" x="860" y="390">Десна</text>
          <text class="scheme__place" x="336" y="226" text-anchor="end">Вишгород</text>
          <circle class="scheme__dot" cx="350" cy="250" r="6" />
          <text class="scheme__place" x="622" y="312">Осещина</text>
          <circle class="scheme__dot" cx="606" cy="276" r="6" />
          <text class="scheme__place" x="200" y="440"><tspan x="200">центр Києва</tspan><tspan x="200" dy="1.2em">23 км</tspan></text>
        </g>
        <g class="scheme__home">
          <circle class="scheme__halo" cx="660" cy="250" r="22" />
          <circle class="scheme__pin" cx="660" cy="250" r="10" />
          <text class="scheme__home-label" x="692" y="238">Міжріччя</text>
        </g>
      </svg>
      <figcaption class="photo-caption">Схема, не в масштабі. За картою містечка.</figcaption>
    </figure>

    <div class="location__near">
      <h3>Поруч</h3>
      <dl class="near">
        {nearby.map((row) => (
          <div class="near__row">
            <dt class="near__km">{row.km}</dt>
            <dd class="near__places">{row.places.join(", ")}</dd>
          </div>
        ))}
      </dl>
      <p class="location__bus">Маршрутне таксі з містечка до метро «Героїв Дніпра» їде близько 20 хвилин.</p>
      <a class="btn btn--secondary" href={contacts.maps} rel="noopener"><Icon name="route" />Прокласти маршрут</a>
    </div>
  </div>
</Section>

<style>
  .location__grid { row-gap: var(--space-6); align-items: start; }
  .location__intro { grid-column: 1 / -1; display: grid; gap: var(--space-5); }
  .location__map { grid-column: 1 / -1; margin: 0; }
  .location__near { grid-column: 1 / -1; display: grid; gap: var(--space-5); justify-items: start; }
  .location__bus { color: var(--muted); max-width: 40ch; }

  .scheme { width: 100%; height: auto; overflow: visible; }
  .scheme__lake { fill: var(--brand); opacity: 0.22; }
  .scheme__river { fill: none; stroke: var(--brand); stroke-linecap: round; stroke-linejoin: round; }
  .scheme__river--dnipro { stroke-width: 30; opacity: 0.55; }
  .scheme__river--desna { stroke-width: 14; }
  .scheme__road { fill: none; stroke: var(--muted); stroke-width: 2.5; stroke-dasharray: 10 8; }
  .scheme__road-label { font: 500 22px var(--font-body); fill: var(--muted); }
  .scheme__hydro { font: italic 400 30px var(--font-label); fill: var(--desna); }
  .scheme__place { font: 400 24px var(--font-body); fill: var(--ink); }
  .scheme text { paint-order: stroke; stroke: var(--paper); stroke-width: 8px; stroke-linejoin: round; }
  .scheme__dot { fill: var(--paper); stroke: var(--ink); stroke-width: 3; }
  .scheme__halo { fill: var(--desna); opacity: 0.16; }
  .scheme__pin { fill: var(--desna); stroke: var(--paper); stroke-width: 4; }
  .scheme__home-label { font: 700 34px var(--font-display); fill: var(--ink); letter-spacing: -0.01em; }

  .near { margin: 0; border-top: var(--hairline); width: 100%; }
  .near__row { display: grid; grid-template-columns: 5.5rem minmax(0, 1fr); gap: var(--space-4); padding-block: var(--space-3); border-bottom: var(--hairline); }
  .near__km { font-weight: 700; font-variant-numeric: tabular-nums; }
  .near__places { margin: 0; color: var(--muted); }

  @media (max-width: 47.99rem) {
    .scheme__place { font-size: 32px; }
    .scheme__hydro { font-size: 38px; }
    .scheme__road-label { font-size: 28px; }
    .scheme__home-label { font-size: 42px; }
  }
  @media (min-width: 64rem) {
    .location__intro { grid-column: 1 / span 5; }
    .location__map { grid-column: 1 / span 8; grid-row: 2; }
    .location__near { grid-column: 9 / span 4; grid-row: 1 / span 2; padding-top: var(--space-2); }
  }

</style>
