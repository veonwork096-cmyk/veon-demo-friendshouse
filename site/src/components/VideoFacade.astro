---
// YouTube facade: local poster, the iframe (youtube-nocookie) loads only after a click. Without JS it is a plain link to the client's confirmed YouTube channel.
import { Picture } from "astro:assets";
import Icon from "./Icon.astro";
import poster from "../assets/video-poster.jpg";
interface Props { id: string; title: string; }
const { id, title } = Astro.props;
---
<div class="yt" data-yt={id} data-rec="W-R303">
  <a class="yt__open" href="https://www.youtube.com/@friendstown3046" rel="noopener" data-title={title}>
    <Picture src={poster} formats={["avif", "webp"]} widths={[480, 800, 1280]} sizes="(min-width: 64rem) 40vw, 100vw" alt="" loading="lazy" decoding="async" />
    <span class="yt__play"><Icon name="play" /></span>
    <span class="yt__label">{title}</span>
  </a>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-yt]").forEach((box) => {
    const link = box.querySelector<HTMLAnchorElement>(".yt__open");
    link?.addEventListener("click", (e) => {
      e.preventDefault();
      const frame = document.createElement("iframe");
      frame.src = `https://www.youtube-nocookie.com/embed/${box.dataset.yt}?autoplay=1&rel=0`;
      frame.title = link.dataset.title ?? "Відео";
      frame.allow = "autoplay; encrypted-media; picture-in-picture; fullscreen";
      frame.allowFullscreen = true;
      box.replaceChildren(frame);
      frame.focus();
    });
  });
</script>

<style>
  .yt { position: relative; aspect-ratio: 16 / 9; border-radius: var(--radius); overflow: hidden; background: var(--ink); }
  .yt :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .yt__open { position: absolute; inset: 0; display: block; color: var(--paper); text-decoration: none; }
  .yt__open :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform var(--dur) var(--ease-out); }
  .yt__open::after { content: ""; position: absolute; inset: 0; background: linear-gradient(to top, var(--photo-shade), transparent 60%); }
  .yt__play {
    position: absolute; left: var(--space-5); bottom: var(--space-5); z-index: 1;
    width: 64px; height: 64px; border-radius: 50%; display: grid; place-items: center;
    background: var(--desna); color: var(--on-accent);
    transition: transform var(--dur-fast) var(--ease-out), background-color var(--dur-fast) var(--ease-out);
  }
  .yt__play :global(svg) { width: 26px; height: 26px; margin-left: var(--space-1); }
  .yt__label { position: absolute; left: calc(var(--space-5) + 64px + var(--space-4)); right: var(--space-5); bottom: calc(var(--space-5) + 18px); z-index: 1; font-weight: 500; line-height: 1.3; }
  .yt__open:hover .yt__play { background: var(--desna-deep); transform: scale(1.05); }
  .yt__open:focus-visible { outline: 3px solid var(--desna); outline-offset: 3px; }
  @media (max-width: 30rem) {
    .yt__play { width: 52px; height: 52px; left: var(--space-4); bottom: var(--space-4); }
    .yt__label { left: calc(var(--space-4) + 52px + var(--space-3)); bottom: calc(var(--space-4) + 14px); font-size: var(--fs-small); }
  }
</style>
